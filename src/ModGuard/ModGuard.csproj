<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModGuard</AssemblyName>
    <RootNamespace>ModGuard</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <!-- Pass -p:GameDir=... if the game lives elsewhere. Nothing is copied unless -p:DeployDir=... is set. -->
    <GameDir Condition="'$(GameDir)' == ''">F:\Program Files (x86)\Steam\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <!-- The official Workshop item and its publisher, built into the DLL. Item 0 means not uploaded yet and turns the
         identity check off; `CoreTests release` refuses a build with 0. The publisher is the maintainer's account,
         the same one that publishes module_forge. -->
    <OfficialItem Condition="'$(OfficialItem)' == ''">3835781654</OfficialItem>
    <OfficialPublisher Condition="'$(OfficialPublisher)' == ''">76561199484674335</OfficialPublisher>
    <!-- Tests pass their own list here, so the hash built into the DLL matches the list they ship. -->
    <BlocklistPath Condition="'$(BlocklistPath)' == ''">blocklist.json</BlocklistPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ManagedDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DseCecil"><HintPath>$(ManagedDir)\DseCecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Localization"><HintPath>$(ManagedDir)\Unity.Localization.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.xml" />
    <None Include="blocklist.json" />
    <None Include="known_mods.json" />
    <None Include="Localization\*.csv" />
  </ItemGroup>

  <!-- Every file that ships beside the DLL, under the path it has in the mod folder. -->
  <ItemGroup>
    <ShippedData Include="manifest.xml" Shipped="manifest.xml" />
    <ShippedData Include="$(BlocklistPath)" Shipped="blocklist.json" />
    <ShippedData Include="known_mods.json" Shipped="known_mods.json" />
    <ShippedData Include="Localization\*.csv" Shipped="Localization/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Writes the hashes of those files, and the official identity, into the DLL for SelfCheck. Only file names and
       hex go into the generated code, so nothing in the data files can change what gets compiled. -->
  <Target Name="WriteSelfData" BeforeTargets="CoreCompile">
    <GetFileHash Files="@(ShippedData)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ShippedHash" />
    </GetFileHash>
    <PropertyGroup>
      <_SelfDataFile>$(IntermediateOutputPath)SelfData.g.cs</_SelfDataFile>
    </PropertyGroup>
    <ItemGroup>
      <_SelfLine Include="// Generated by ModGuard.csproj from the files that ship beside the DLL. Do not edit." />
      <_SelfLine Include="namespace ModGuard {" />
      <_SelfLine Include="internal static class SelfData {" />
      <_SelfLine Include="internal static readonly ulong OfficialItem = $([System.UInt64]::Parse($(OfficialItem)))UL%3B" />
      <_SelfLine Include="internal static readonly ulong OfficialPublisher = $([System.UInt64]::Parse($(OfficialPublisher)))UL%3B" />
      <_SelfLine Include="internal static readonly string[][] Files = {" />
      <_SelfLine Include="@(_ShippedHash->'new[] { &quot;%(Shipped)&quot;, &quot;%(FileHash)&quot; },')" />
      <_SelfLine Include="}%3B" />
      <_SelfLine Include="}" />
      <_SelfLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_SelfDataFile)" Lines="@(_SelfLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_SelfDataFile)" />
      <FileWrites Include="$(_SelfDataFile)" />
    </ItemGroup>
  </Target>

  <Target Name="CopyOutput" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <ItemGroup>
      <LocFiles Include="Localization\*.csv" />
    </ItemGroup>
    <MakeDir Directories="$(DeployDir);$(DeployDir)\Localization" />
    <Copy SourceFiles="$(OutputPath)ModGuard.dll;manifest.xml;known_mods.json" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(BlocklistPath)" DestinationFiles="$(DeployDir)\blocklist.json" />
    <Copy SourceFiles="@(LocFiles)" DestinationFolder="$(DeployDir)\Localization" />
  </Target>

</Project>
